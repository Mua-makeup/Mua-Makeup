
# 1. Cơ sở dữ liệu PostgreSQL & PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# 2. Redis & Redis GEO
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Apache Kafka Event Broker
KAFKA_SERVERS=localhost:9092
ZOOKEEPER_PORT=2181

# 4. JWT Authentication & Security
JWT_SECRET=your_base64_or_hex_encoded_256bit_secret_key_here
JWT_EXPIRATION_MS=86400000          # 24 giờ
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 ngày

# 5. Cổng thanh toán VNPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# 6. Cổng thanh toán MoMo
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create

# 7. Cloudinary Media Storage (Gói dịch vụ & Ảnh Before/After)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 8. Bản đồ & Tính khoảng cách (Google Maps / Goong Maps)
GOONG_MAPS_API_KEY=your_goong_maps_api_key

# 9. Sentry Error Tracking (Production Monitoring)
SENTRY_DSN=your_sentry_dsn_url
