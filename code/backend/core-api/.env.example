# ============================================================================
# MAKEUP BOOKING PLATFORM - CORE API (.env)
# ============================================================================

# 1. Active Profile (dev hoặc prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# 2. Database PostgreSQL & PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=makeup_platform_db
DB_USER=postgres
DB_PASSWORD=123456

# 3. Redis & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. JWT & Security
JWT_SECRET=MakeupBookingPlatformLayeredMonolithSecretKey2026MustBeSecureLongKey!
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# 5. CORS Origins (ngăn cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# 6. Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# 7. Goong Maps
GOONG_API_KEY=dummy_goong_key
GOONG_BASE_URL=https://rsapi.goong.io
